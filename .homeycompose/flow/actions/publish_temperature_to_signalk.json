{
  "id": "publish_temperature_to_signalk",
  "title": {
    "en": "Publish cabin temperature (°C) to Signal K"
  },
  "titleFormatted": {
    "en": "Publish temperature [[temperature_c]]°C for zone [[zone]] to Signal K"
  },
  "hint": {
    "en": "Converts Celsius to Kelvin and publishes to environment.inside.<zone>.temperature via Signal K delta stream."
  },
  "args": [
    {
      "name": "zone",
      "type": "dropdown",
      "title": {
        "en": "Cabin Zone"
      },
      "values": [
        { "id": "mainCabin", "title": { "en": "Main Cabin" } },
        { "id": "saloon", "title": { "en": "Saloon" } },
        { "id": "forwardCabin", "title": { "en": "Forward Cabin" } },
        { "id": "aftCabin", "title": { "en": "Aft Cabin" } },
        { "id": "galley", "title": { "en": "Galley" } },
        { "id": "engineRoom", "title": { "en": "Engine Room" } },
        { "id": "heads", "title": { "en": "Heads" } },
        { "id": "lazarette", "title": { "en": "Lazarette" } }
      ]
    },
    {
      "name": "temperature_c",
      "type": "number",
      "title": {
        "en": "Temperature (°C)"
      },
      "min": -50,
      "max": 150,
      "step": 0.1
    }
  ]
}
