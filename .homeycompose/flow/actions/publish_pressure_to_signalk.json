{
  "id": "publish_pressure_to_signalk",
  "title": {
    "en": "Publish barometric pressure (hPa) to Signal K"
  },
  "titleFormatted": {
    "en": "Publish pressure [[pressure_hpa]] hPa for zone [[zone]] to Signal K"
  },
  "hint": {
    "en": "Converts hPa/mbar to Pascals (Pa) and publishes to environment.inside.<zone>.pressure."
  },
  "args": [
    {
      "name": "zone",
      "type": "dropdown",
      "title": {
        "en": "Cabin Zone"
      },
      "values": [
        { "id": "mainCabin", "title": { "en": "Main Cabin" } },
        { "id": "saloon", "title": { "en": "Saloon" } },
        { "id": "forwardCabin", "title": { "en": "Forward Cabin" } },
        { "id": "aftCabin", "title": { "en": "Aft Cabin" } },
        { "id": "galley", "title": { "en": "Galley" } },
        { "id": "engineRoom", "title": { "en": "Engine Room" } },
        { "id": "heads", "title": { "en": "Heads" } },
        { "id": "lazarette", "title": { "en": "Lazarette" } }
      ]
    },
    {
      "name": "pressure_hpa",
      "type": "number",
      "title": {
        "en": "Pressure (hPa)"
      },
      "min": 800,
      "max": 1100,
      "step": 0.1
    }
  ]
}
