{
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "discovery": "signalk",
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"
  },
  "pair": [
    {
      "id": "connect_server"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "reconnect_server"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Signal K Server Connection"
      },
      "children": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "Server Host / IP"
          },
          "value": "openplotter.local"
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Server Port"
          },
          "value": 3000,
          "min": 1,
          "max": 65535
        },
        {
          "id": "useTls",
          "type": "checkbox",
          "label": {
            "en": "Use HTTPS / WSS (TLS)"
          },
          "value": false
        },
        {
          "id": "allowSelfSigned",
          "type": "checkbox",
          "label": {
            "en": "Allow Self-Signed TLS Certificates"
          },
          "value": true
        },
        {
          "id": "token",
          "type": "password",
          "label": {
            "en": "Signal K JWT Bearer Token"
          },
          "value": ""
        },
        {
          "id": "throttleTier",
          "type": "dropdown",
          "label": {
            "en": "Update Throttling Tier"
          },
          "value": "medium",
          "values": [
            {
              "id": "fast",
              "label": {
                "en": "Fast (200 ms - Alarms & Switches)"
              }
            },
            {
              "id": "medium",
              "label": {
                "en": "Medium (2 s - Navigation & Wind)"
              }
            },
            {
              "id": "slow",
              "label": {
                "en": "Slow (5 s - Batteries, Tanks & Environment)"
              }
            }
          ]
        },
        {
          "id": "sourceFilter",
          "type": "text",
          "label": {
            "en": "Optional Signal K $source Filter"
          },
          "value": ""
        }
      ]
    }
  ]
}
