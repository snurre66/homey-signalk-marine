[
  {
    "type": "group",
    "label": {
      "en": "Signal K Server Connection"
    },
    "children": [
      {
        "id": "host",
        "type": "text",
        "label": {
          "en": "Server Host / IP"
        },
        "value": "openplotter.local"
      },
      {
        "id": "port",
        "type": "number",
        "label": {
          "en": "Server Port"
        },
        "value": 3000,
        "min": 1,
        "max": 65535
      },
      {
        "id": "useTls",
        "type": "checkbox",
        "label": {
          "en": "Use HTTPS / WSS (TLS)"
        },
        "value": false
      },
      {
        "id": "allowSelfSigned",
        "type": "checkbox",
        "label": {
          "en": "Allow Self-Signed TLS Certificates"
        },
        "value": true
      },
      {
        "id": "token",
        "type": "password",
        "label": {
          "en": "Signal K JWT Bearer Token"
        },
        "value": ""
      },
      {
        "id": "throttleTier",
        "type": "dropdown",
        "label": {
          "en": "Update Throttling Tier"
        },
        "value": "fast",
        "values": [
          {
            "id": "fast",
            "label": {
              "en": "Fast (200 ms - Switches & Relays)"
            }
          },
          {
            "id": "medium",
            "label": {
              "en": "Medium (2 s - Balanced)"
            }
          },
          {
            "id": "slow",
            "label": {
              "en": "Slow (5 s - Power Saving)"
            }
          }
        ]
      },
      {
        "id": "sourceFilter",
        "type": "text",
        "label": {
          "en": "Optional Signal K $source Filter (required for multi-source switches)"
        },
        "value": ""
      },
      {
        "id": "putTimeoutMs",
        "type": "number",
        "label": {
          "en": "PUT Command Timeout (ms)"
        },
        "units": {
          "en": "ms"
        },
        "value": 5000,
        "min": 100,
        "max": 30000
      }
    ]
  }
